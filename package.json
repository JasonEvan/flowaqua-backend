{
  "name": "flowaqua-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FlowAqua backend built with Express and TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/data-source.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
