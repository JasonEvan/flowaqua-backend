PORT=3000
VERSION=1.0.0
# GitHub username or organization, lowercase (required for Docker).
GHCR_OWNER=

# Supabase Dashboard > Connect > PostgreSQL URI.
# Prefer the session pooler (port 5432) on IPv4-only hosts.
# URL-encode special characters in the password. Do not add sslmode parameters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
